---
import BaseLayout from "@/layouts/BaseLayout.astro";
import HeroSlider from "@/components/HeroSlider.astro";
import ContactForm from "@/components/ContactForm.astro";
import { siteConfig } from "@/config/site.config";
import { productCategories } from "@/data/products";
import { industries } from "@/data/industries";
import { approvedBrands } from "@/data/tradeNetwork";

const brandLogoMap: Record<string, string> = {
  "Schneider Electric": "/images/brands/schneider-electric.png",
  "RS Components": "/images/brands/rs-components.png",
  "Siemens": "/images/brands/siemens.png",
  "Omron": "/images/brands/omron.png",
  "SKF": "/images/brands/skf.png",
  "Molex": "/images/brands/molex.png",
  "Festo": "/images/brands/festo.png",
  "3M": "/images/brands/3m.png",
  "Flowserve": "/images/brands/flowserve.png",
  "Fluke": "/images/brands/fluke.png",
  "STMicroelectronics": "/images/brands/stmicroelectronics.png",
  "SMC": "/images/brands/smc.png",
  "McMaster-Carr": "/images/brands/mcmaster-carr.png",
  "L&T Valves": "/images/brands/lt-valves.png",
};
const seoTitle = "LANCOX FZCO | Industrial Trading Company Dubai UAE";
const seoDescription =
  "LANCOX FZCO is a trusted industrial trading company based in Dubai, UAE. Supplying certified Electrical, Mechanical, Fasteners, Instrumentation, and Safety products to Oil & Gas, Energy, and Construction across UAE & Middle East.";

const credibilityHighlights = [
  {
    title: "Strategic Distribution Hub",
    description: "Centrally positioned in Dubai with multimodal regional connectivity across UAE & GCC.",
    icon: "M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4",
  },
  {
    title: "Approved Global Brands",
    description: "Direct sourcing corridors from certified manufacturers in Europe, US & Asia.",
    icon: "M3.055 11H5a2 2 0 012 2v1a2 2 0 002 2 2 2 0 012 2v2.945M8 3.935V5.5A2.5 2.5 0 0010.5 8h.5a2 2 0 012 2 2 2 0 104 0 2 2 0 012-2h1.064M15 20.488V18a2 2 0 012-2h3.064M21 12a9 9 0 11-18 0 9 9 0 0118 0z",
  },
  {
    title: "Traceable Quality & MTC",
    description: "All products backed by EN 10204 3.1 test certificates and full compliance.",
    icon: "M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z",
  },
  {
    title: "Fast RFQ Turnaround",
    description: "Responsive commercial desk providing prompt, competitive multi-item quotes.",
    icon: "M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z",
  },
];
---

<BaseLayout title={seoTitle} description={seoDescription} headerOverlay>

  <!-- 1. Hero (header floats over it; bottom edge is cut at the logo-mark angle) -->
  <HeroSlider />

  <!-- 2. Credentials: floating plate that straddles the hero edge -->
  <section class="relative z-30 -mt-[72px] sm:-mt-[84px] lg:-mt-[96px] pb-4" aria-label="Credentials Overview">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="relative bg-white border border-industrial-border shadow-soft-xl">
        <span class="absolute left-0 top-0 h-[3px] w-24 bg-bronze-500" aria-hidden="true"></span>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 divide-y sm:divide-y-0 lg:divide-x divide-industrial-divider" data-motion-stagger>
          {credibilityHighlights.map((item) => (
            <div class="flex items-start gap-3.5 p-5 sm:p-6" data-motion-item>
              <div class="w-10 h-10 rounded bg-bronze-50 border border-bronze-200 text-bronze-800 flex items-center justify-center shrink-0">
                <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d={item.icon} />
                </svg>
              </div>
              <div>
                <h3 class="text-sm font-display font-bold text-ink mb-0.5">{item.title}</h3>
                <p class="text-xs text-ink-secondary leading-relaxed">{item.description}</p>
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- 3. Company Introduction -->
  <section class="py-14 sm:py-20 bg-canvas border-b border-industrial-border">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 items-center">
        
        <!-- Left: Clean Narrative -->
        <div class="lg:col-span-7 space-y-4" data-motion-fade-left>
          <div class="inline-flex items-center gap-2 px-3 py-1 rounded bg-bronze-50 border border-bronze-200 text-bronze-800 text-xs font-bold uppercase tracking-wider">
            LANCOX FZCO • DUBAI, UAE
          </div>
          
          <h2 class="text-2xl sm:text-3xl lg:text-4xl font-display font-extrabold text-ink tracking-tight">
            Trusted Industrial & Technical Suppliers in Dubai, UAE
          </h2>

          <p class="text-sm sm:text-base text-ink-secondary leading-relaxed pt-1">
            <strong>LANCOX FZCO</strong> is a premier industrial supply and trading enterprise based in Dubai, United Arab Emirates. We specialize in sourcing and delivering certified electrical equipment, mechanical piping, industrial valves, fasteners, instrumentation, and PPE safety supplies to contractors, engineers, and plant operators across the UAE and Middle East.
          </p>

          <p class="text-sm text-ink-secondary leading-relaxed">
            Operating from our commercial showroom at Dubai Traders Market (Yiwu Market), we maintain direct procurement channels with accredited manufacturers across Europe, the US, and Asia. Whether you require urgent stock items or consolidated multi-category project packages, our team ensures dependable delivery, genuine quality, and fair market pricing.
          </p>

          <div class="pt-2 flex flex-wrap items-center gap-4">
            <a
              href="/about/"
              class="inline-flex items-center px-5 py-2.5 bg-ink hover:bg-bronze-700 text-white font-display font-semibold text-xs uppercase tracking-wider rounded transition-colors"
            >
              <span>About Our Company</span>
              <svg class="w-3.5 h-3.5 ml-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
              </svg>
            </a>

            <a
              href={`tel:${siteConfig.contact.phone}`}
              class="inline-flex items-center gap-2 text-xs font-semibold text-ink hover:text-bronze-700 transition-colors"
            >
              <svg class="w-4 h-4 text-bronze-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
              </svg>
              <span>Call Desk: {siteConfig.contact.phoneDisplay}</span>
            </a>
          </div>
        </div>

        <!-- Right: Real Business Blueprint Visual & Core Policies -->
        <div class="lg:col-span-5 space-y-4" data-motion-fade-right>
          <div class="rounded-lg overflow-hidden border border-industrial-border shadow-soft-sm bg-white">
            <img
              src="/images/business-handshake.jpg"
              alt="Engineers reviewing blueprints - LANCOX FZCO trusted partnerships"
              width="600"
              height="350"
              class="w-full h-auto object-cover aspect-[16/10]"
              loading="lazy"
            />
          </div>

          <div class="grid grid-cols-2 gap-4">
            <div class="p-4 rounded-lg bg-white border border-industrial-border shadow-soft-sm">
              <span class="text-xs font-bold uppercase tracking-wider text-bronze-700 block mb-1">Our Mission</span>
              <p class="text-xs text-ink-muted leading-relaxed">
                Reliable supply bridge connecting contractors with genuine industrial equipment.
              </p>
            </div>
            <div class="p-4 rounded-lg bg-white border border-industrial-border shadow-soft-sm">
              <span class="text-xs font-bold uppercase tracking-wider text-bronze-700 block mb-1">Quality Policy</span>
              <p class="text-xs text-ink-muted leading-relaxed">
                100% adherence to API, ASME, ASTM, IEC, DIN & ISO engineering standards.
              </p>
            </div>
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- 4. Our Product Divisions (Clean, Visual, High-Conversion Grid - Maxtech Style) -->
  <section id="products" class="py-14 sm:py-20 bg-white border-b border-industrial-border">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="flex flex-col sm:flex-row sm:items-end justify-between mb-10" data-motion-fade>
        <div>
          <span class="text-xs font-bold uppercase tracking-wider text-bronze-700 block mb-1">
            Product Portfolio
          </span>
          <h2 class="text-2xl sm:text-3xl lg:text-4xl font-display font-extrabold text-ink">
            Our Products
          </h2>
          <p class="mt-2 text-sm text-ink-muted max-w-xl">
            Certified technical equipment, piping materials, bolting hardware, and safety gear.
          </p>
        </div>

        <div class="mt-4 sm:mt-0">
          <a
            href="/products/"
            class="inline-flex items-center text-xs font-bold uppercase tracking-wider text-bronze-700 hover:text-bronze-900 group"
          >
            <span>View All Divisions</span>
            <svg class="w-3.5 h-3.5 ml-1 group-hover:translate-x-1 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
            </svg>
          </a>
        </div>
      </div>

      <!-- 5 Product Division Cards -->
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 sm:gap-8" data-motion-stagger>
        {productCategories.map((category, idx) => (
          <article
            class={`bg-canvas rounded-lg border border-industrial-border shadow-soft-sm hover:border-bronze-400 hover:shadow-soft-md transition-all flex flex-col justify-between overflow-hidden group ${idx === 0 ? "md:col-span-2 lg:col-span-1" : ""}`}
            data-motion-item
          >
            <!-- Card Image -->
            <a href={`/products/${category.slug}/`} class="relative block overflow-hidden aspect-[16/10] bg-canvas-subtle border-b border-industrial-border">
              <img
                src={category.image}
                alt={`${category.name} - LANCOX FZCO`}
                width="600"
                height="375"
                class="w-full h-full object-cover group-hover:scale-103 transition-transform duration-500"
                loading="lazy"
              />
              <div class="absolute top-3 left-3">
                <span class="text-[11px] font-bold uppercase tracking-wider text-bronze-800 bg-white/95 px-2.5 py-1 rounded shadow-soft-sm border border-bronze-200">
                  Division 0{idx + 1}
                </span>
              </div>
            </a>

            <!-- Card Content -->
            <div class="p-5 sm:p-6 flex-1 flex flex-col justify-between">
              <div>
                <span class="text-[11px] uppercase font-semibold text-ink-muted block mb-1">
                  {category.standards.slice(0, 3).join(" • ")}
                </span>
                
                <h3 class="text-lg sm:text-xl font-display font-bold text-ink group-hover:text-bronze-700 transition-colors">
                  <a href={`/products/${category.slug}/`}>
                    {category.name}
                  </a>
                </h3>

                <p class="mt-2 text-xs sm:text-sm text-ink-secondary leading-relaxed line-clamp-2">
                  {category.tagline}
                </p>

                <!-- Primary Items List (Like Maxtech) -->
                <div class="mt-4 pt-3 border-t border-industrial-border">
                  <span class="text-[11px] font-semibold uppercase text-ink-muted block mb-1.5">
                    Primary Lines:
                  </span>
                  <ul class="space-y-1 text-xs text-ink-secondary">
                    {category.productFamilies.slice(0, 3).map((fam) => (
                      <li class="flex items-start gap-2">
                        <span class="text-bronze-600 font-bold">•</span>
                        <span class="font-medium text-ink">{fam.name}</span>
                      </li>
                    ))}
                  </ul>
                </div>
              </div>

              <!-- Card Action Links -->
              <div class="mt-6 pt-4 border-t border-industrial-border flex items-center justify-between text-xs">
                <a
                  href={`/products/${category.slug}/`}
                  class="font-bold uppercase tracking-wider text-ink group-hover:text-bronze-700 flex items-center gap-1 transition-colors"
                >
                  <span>Technical Specs</span>
                  <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                  </svg>
                </a>

                <a
                  href={`/contact/?division=${category.slug}#rfq`}
                  class="font-semibold text-bronze-700 hover:text-bronze-900"
                >
                  Get a Quote &rarr;
                </a>
              </div>
            </div>
          </article>
        ))}
      </div>

    </div>
  </section>

  <!-- 5. Approved Brands & Manufacturers (Trust Foundation — Maxtech Reference) -->
  <section class="py-14 sm:py-20 bg-canvas border-b border-industrial-border">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="text-center max-w-2xl mx-auto mb-10" data-motion-fade>
        <span class="text-xs font-bold uppercase tracking-wider text-bronze-700 block mb-1">
          Accredited Supply Lines
        </span>
        <h2 class="text-2xl sm:text-3xl font-display font-extrabold text-ink">
          Our Approved Brands
        </h2>
        <p class="mt-2 text-xs sm:text-sm text-ink-muted">
          We procure genuine components directly from verified international manufacturers.
        </p>
      </div>

      <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-3 sm:gap-4" data-motion-stagger>
        {approvedBrands.slice(0, 12).map((brand) => {
          const logoSrc = brandLogoMap[brand.name];
          return (
            <div
              class="p-4 rounded-lg bg-white border border-industrial-border shadow-soft-sm hover:border-bronze-400 transition-colors flex items-center gap-3.5"
              data-motion-item
            >
              <div class="w-12 h-10 flex items-center justify-center shrink-0">
                {logoSrc ? (
                  <img
                    src={logoSrc}
                    alt={`${brand.name} logo`}
                    width="48"
                    height="40"
                    class="max-w-full max-h-full object-contain"
                    loading="lazy"
                  />
                ) : (
                  <div class="w-9 h-9 rounded bg-ink text-white font-display font-extrabold text-xs flex items-center justify-center">
                    <span class="text-bronze-400">{brand.name.substring(0, 2).toUpperCase()}</span>
                  </div>
                )}
              </div>
              <div class="truncate">
                <h3 class="font-display font-bold text-sm text-ink truncate">{brand.name}</h3>
                <span class="text-[11px] text-ink-muted block truncate">{brand.category}</span>
              </div>
            </div>
          );
        })}

      </div>

      <div class="mt-8 text-center" data-motion-fade>
        <a
          href="/trade-network/"
          class="inline-flex items-center text-xs font-semibold text-bronze-700 hover:text-bronze-900"
        >
          <span>View Full Trade Network & International Standards &rarr;</span>
        </a>
      </div>

    </div>
  </section>

  <!-- 6. Industries Served (Sector Scope) -->
  <section class="py-14 sm:py-20 bg-white border-b border-industrial-border">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="text-center max-w-2xl mx-auto mb-10" data-motion-fade>
        <span class="text-xs font-bold uppercase tracking-wider text-bronze-700 block mb-1">
          Sector Experience
        </span>
        <h2 class="text-2xl sm:text-3xl font-display font-extrabold text-ink">
          Industries Served Across UAE & Middle East
        </h2>
        <p class="mt-2 text-xs sm:text-sm text-ink-muted">
          Supporting regional capital projects, EPC contractors, and plant maintenance operations.
        </p>
      </div>

      <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-6 gap-3 sm:gap-4" data-motion-stagger>
        {industries.map((ind) => (
          <a
            href={`/industries/#${ind.id}`}
            class="rounded-lg bg-canvas border border-industrial-border overflow-hidden hover:border-bronze-400 hover:shadow-soft-sm transition-all group flex flex-col"
            data-motion-item
          >
            <div class="aspect-[4/3] overflow-hidden bg-canvas-subtle">
              <img
                src={ind.image}
                alt={ind.name}
                width="300"
                height="225"
                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                loading="lazy"
              />
            </div>
            <div class="p-3 text-center flex-1 flex flex-col justify-center">
              <h3 class="font-display font-bold text-xs text-ink group-hover:text-bronze-700 transition-colors">
                {ind.name}
              </h3>
            </div>
          </a>
        ))}
      </div>

    </div>
  </section>

  <!-- 7. Quick Request for Quotation (Direct Commercial Conversion) -->
  <section id="rfq" class="py-14 sm:py-20 bg-canvas">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-10">
        
        <!-- Left: Office Coordinates & Immediate Contact -->
        <div class="lg:col-span-5 space-y-6" data-motion-fade-left>
          <div>
            <span class="text-xs font-bold uppercase tracking-wider text-bronze-700 block mb-1">
              Commercial Desk
            </span>
            <h2 class="text-2xl sm:text-3xl font-display font-extrabold text-ink">
              Get in Touch with Our Trading Team
            </h2>
            <p class="mt-2 text-xs sm:text-sm text-ink-secondary leading-relaxed">
              Have an urgent requirement or an upcoming project BOQ? Contact our commercial procurement team in Dubai, UAE for immediate assistance.
            </p>
          </div>

          <!-- Contact Cards -->
          <div class="space-y-3 text-xs sm:text-sm text-ink-secondary">
            <div class="p-4 rounded-lg bg-white border border-industrial-border shadow-soft-sm flex items-start gap-3">
              <div class="w-8 h-8 rounded bg-bronze-50 border border-bronze-200 text-bronze-800 flex items-center justify-center shrink-0 mt-0.5">
                <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
                </svg>
              </div>
              <div>
                <strong class="font-bold text-ink block">Office Location:</strong>
                <span>{siteConfig.address.full}</span>
              </div>
            </div>

            <div class="p-4 rounded-lg bg-white border border-industrial-border shadow-soft-sm flex items-start gap-3">
              <div class="w-8 h-8 rounded bg-bronze-50 border border-bronze-200 text-bronze-800 flex items-center justify-center shrink-0 mt-0.5">
                <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
                </svg>
              </div>
              <div>
                <strong class="font-bold text-ink block">Telephone:</strong>
                <a href={`tel:${siteConfig.contact.phone}`} class="hover:text-bronze-700 font-medium text-ink">
                  {siteConfig.contact.phoneDisplay}
                </a>
              </div>
            </div>

            <div class="p-4 rounded-lg bg-white border border-industrial-border shadow-soft-sm flex items-start gap-3">
              <div class="w-8 h-8 rounded bg-bronze-50 border border-bronze-200 text-bronze-800 flex items-center justify-center shrink-0 mt-0.5">
                <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
                </svg>
              </div>
              <div>
                <strong class="font-bold text-ink block">Email:</strong>
                <a href={`mailto:${siteConfig.contact.email}`} class="hover:text-bronze-700 font-medium text-ink">
                  {siteConfig.contact.email}
                </a>
              </div>
            </div>
          </div>

          <!-- Instant WhatsApp Action -->
          <a
            href={siteConfig.social.whatsappLink}
            target="_blank"
            rel="noopener noreferrer"
            class="w-full flex items-center justify-center gap-2 px-4 py-3 bg-emerald-600 hover:bg-emerald-700 text-white font-display font-semibold text-xs uppercase tracking-wider rounded transition-colors shadow-soft-sm"
          >
            <span class="w-2 h-2 rounded-full bg-white animate-pulse"></span>
            <span>WhatsApp Quick Desk: {siteConfig.contact.whatsappDisplay}</span>
          </a>
        </div>

        <!-- Right: Practical RFQ Form -->
        <div class="lg:col-span-7" data-motion-fade-right>
          <ContactForm formId="home-rfq-form" />
        </div>

      </div>
    </div>
  </section>

</BaseLayout>
