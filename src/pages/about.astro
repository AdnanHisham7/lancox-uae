---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Breadcrumbs from "@/components/Breadcrumbs.astro";
import Marquee from "@/components/Marquee.astro";
import { siteConfig } from "@/config/site.config";

const seoTitle = "About LANCOX FZCO | Industrial Trading Company Dubai UAE";
const seoDescription =
  "Learn about LANCOX FZCO, a premier industrial trading enterprise in Dubai, UAE. Discover our vision, corporate objectives, global supplier network, and technical trading scope.";

const corporateObjectives = [
  {
    title: "Comprehensive Industrial Scope",
    description:
      "To become the comprehensive provider of industrial goods and consumables for clients in different categories of industries.",
    icon: "M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10",
  },
  {
    title: "Service Quality & Cost-Effectiveness",
    description:
      "Emphasis on service quality through providing requirements within short amount of time and cost.",
    icon: "M13 10V3L4 14h7v7l9-11h-7z",
  },
  {
    title: "Reputable Global Partnerships",
    description:
      "Built partnership with reputed suppliers and manufacturers across the globe to ensure dependable inventory of products.",
    icon: "M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z",
  },
  {
    title: "Fail-Safe After-Sale Services",
    description:
      "Optimize performance through fail-safe after sale services, technical documentation, and long-term customer support.",
    icon: "M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z",
  },
];

const coreValues = [
  { name: "Quality Assurance", detail: "Strict adherence to international engineering standards (API, ASME, ASTM, IEC, DIN, ISO)." },
  { name: "Operational Efficiency", detail: "Streamlined procurement workflows, fast quote turnarounds, and expedited customs clearance & dispatch." },
  { name: "Supply Reliability", detail: "Transparent communication on manufacturing lead times and delivery schedules with zero surprises." },
  { name: "Customer-Centric Service", detail: "Dedicated procurement desks providing tailored multi-category consolidation for contractors and plant managers." },
];

const breadcrumbs = [
  { label: "About LANCOX FZCO", href: "/about/" }
];
---

<BaseLayout title={seoTitle} description={seoDescription} breadcrumbs={[{ name: "About LANCOX FZCO", item: "https://lancoxuae.com/about/" }]}>
  
  <div class="bg-canvas-subtle border-b border-industrial-border">
    <Breadcrumbs items={breadcrumbs} />
  </div>

  <!-- Hero Banner -->
  <section class="py-14 sm:py-20 bg-canvas-subtle border-b border-industrial-border relative overflow-hidden">
    <div class="absolute inset-0 bg-industrial-grid opacity-50 pointer-events-none"></div>

    <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl" data-motion-hero>
        <span class="text-xs font-semibold uppercase tracking-widest text-bronze-700 block mb-2">
          Company Profile & Operations
        </span>
        <!-- Single Canonical H1 -->
        <h1 class="text-3xl sm:text-5xl font-display font-extrabold text-ink tracking-tight">
          About LANCOX FZCO
        </h1>
        <p class="mt-4 text-base sm:text-lg text-ink-secondary leading-relaxed">
          A premier industrial trading enterprise based in Dubai, United Arab Emirates, specializing in the international procurement and supply of high-grade industrial equipment, mechanical piping, electrical systems, fasteners, and safety gear.
        </p>
        <blockquote class="mt-6 border-l-2 border-bronze-500 pl-4 text-sm font-medium italic text-bronze-800">
          "{siteConfig.tagline}"
        </blockquote>
      </div>
    </div>
  </section>

  <!-- Business Positioning & Activities -->
  <section class="py-16 sm:py-24 bg-white border-b border-industrial-border">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
        <div class="lg:col-span-7 space-y-5 text-ink-secondary text-sm sm:text-base leading-relaxed" data-motion-fade-left>
          <span class="text-xs font-semibold uppercase tracking-widest text-bronze-700 block">
            Activities & Purpose
          </span>
          <h2 class="text-2xl sm:text-3xl font-display font-bold text-ink">
            A Strategic Bridge Between Demand and Supply
          </h2>
          <p>
            <strong>LANCOX FZCO</strong> operates on a strong motive of becoming a bridge between different types of industries in the Middle East and across the globe. The service spectrum encompasses products, equipment, and consumables from <strong>Electrical, Mechanical, Safety, Fasteners, Instrumentation, and Trading</strong> sectors.
          </p>
          <p>
            LANCOX ensures finest quality products by uninterrupted cataloging of various products from manufacturers and suppliers around the world. We specialize in procuring and delivering high-quality supplies to General Industries, Construction, Processing & Manufacturing, Oil & Gas, Energy, and Petrochemical companies.
          </p>
          <p>
            At LANCOX, we don't just trade. On the contrary, we empower industries to thrive by discovering a world of precision, trust, and unparalleled service with us.
          </p>

          <div class="pt-4 grid grid-cols-2 gap-4 text-xs">
            <div class="p-3.5 bg-canvas rounded border border-industrial-border">
              <span class="font-bold text-ink block mb-0.5">Corporate Structure</span>
              <span class="text-ink-muted">Registered trading enterprise in Dubai, United Arab Emirates.</span>
            </div>
            <div class="p-3.5 bg-canvas rounded border border-industrial-border">
              <span class="font-bold text-ink block mb-0.5">Commercial Showroom</span>
              <span class="text-ink-muted">Unit G6304, Ground Floor, Dubai Traders Market, Yiwu Market.</span>
            </div>
          </div>
        </div>

        <!-- Right Side: Key Pillars Summary Box -->
        <div class="lg:col-span-5 bg-canvas-subtle p-8 rounded-lg border border-industrial-border shadow-soft-sm" data-motion-fade-right>
          <h3 class="font-display font-bold text-lg text-ink mb-4 pb-2 border-b border-industrial-border">
            Core Operating Principles
          </h3>
          <ul class="space-y-4 text-xs sm:text-sm">
            {coreValues.map((val) => (
              <li class="flex items-start gap-3">
                <div class="w-5 h-5 rounded-full bg-bronze-100 text-bronze-700 flex items-center justify-center shrink-0 mt-0.5 font-bold text-xs">
                  ✓
                </div>
                <div>
                  <strong class="font-semibold text-ink block">{val.name}</strong>
                  <span class="text-ink-muted">{val.detail}</span>
                </div>
              </li>
            ))}
          </ul>

          <div class="mt-8 pt-6 border-t border-industrial-border">
            <a
              href="/contact/"
              class="w-full flex items-center justify-center px-4 py-3 bg-ink hover:bg-bronze-700 text-white text-xs font-semibold uppercase tracking-wider rounded transition-colors"
            >
              Contact Our Commercial Team
            </a>
          </div>
        </div>
      </div>

    </div>
  </section>

  <!-- The Vision & The Mission with Blueprint Handshake Image (From PDF Page 3) -->
  <section class="py-16 sm:py-24 bg-canvas border-b border-industrial-border">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 items-center mb-14">
        <div class="lg:col-span-6 rounded-lg overflow-hidden border border-industrial-border shadow-soft-md bg-white" data-motion-fade-left>
          <img
            src="/images/business-handshake.jpg"
            alt="Business handshake between engineers over industrial blueprints - LANCOX FZCO trusted partnerships"
            width="1280"
            height="720"
            class="w-full h-full object-cover aspect-[16/10]"
            loading="lazy"
          />
        </div>

        <div class="lg:col-span-6 space-y-6" data-motion-fade-right>
          <div class="p-6 sm:p-8 rounded-lg bg-white border border-industrial-border shadow-soft-sm">
            <div class="flex items-center gap-2 mb-2">
              <span class="w-2.5 h-2.5 rounded-full bg-bronze-600"></span>
              <h3 class="font-display font-extrabold text-xl text-ink">The Vision</h3>
            </div>
            <p class="text-sm text-ink-secondary leading-relaxed">
              At LANCOX FZCO, we deliver high-quality, cost-effective trading solutions, offering mechanical products, tools, safety gear, and industrial supplies to clients in the Middle East. Committed to innovation and excellence, we provide exceptional service to support business growth and success as a trusted partner.
            </p>
          </div>

          <div class="p-6 sm:p-8 rounded-lg bg-white border border-industrial-border shadow-soft-sm">
            <div class="flex items-center gap-2 mb-2">
              <span class="w-2.5 h-2.5 rounded-full bg-emerald-600"></span>
              <h3 class="font-display font-extrabold text-xl text-ink">The Mission</h3>
            </div>
            <p class="text-sm text-ink-secondary leading-relaxed">
              We are dedicated to delivering reliable, high-quality products and services, tailored to meet each client's unique needs. By prioritizing innovation and staying ahead of industry trends, we ensure consistent satisfaction and provide cutting-edge solutions that our clients can depend on.
            </p>
          </div>
        </div>
      </div>

    </div>
  </section>

  <!-- Corporate Objectives (From Company Profile) -->
  <section id="vision-mission" class="py-16 sm:py-24 bg-white border-b border-industrial-border">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="max-w-2xl mb-12" data-motion-fade>
        <span class="text-xs font-semibold uppercase tracking-widest text-bronze-700 block mb-2">
          Strategic Goals
        </span>
        <h2 class="text-2xl sm:text-4xl font-display font-extrabold text-ink">
          Company Objectives
        </h2>
        <p class="mt-3 text-sm sm:text-base text-ink-secondary">
          Our operational objectives are centered on delivering measurable value to procurement officers, engineers, and plant maintenance teams.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-8" data-motion-stagger>
        {corporateObjectives.map((obj, i) => (
          <div class="bg-canvas p-6 sm:p-8 rounded-lg border border-industrial-border shadow-soft-sm hover:border-bronze-400 transition-colors" data-motion-item>
            <div class="w-10 h-10 rounded bg-bronze-50 border border-bronze-200 text-bronze-800 flex items-center justify-center mb-4">
              <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d={obj.icon} />
              </svg>
            </div>
            <h3 class="text-lg font-display font-bold text-ink mb-2">
              0{i + 1}. {obj.title}
            </h3>
            <p class="text-xs sm:text-sm text-ink-secondary leading-relaxed">
              {obj.description}
            </p>
          </div>
        ))}
      </div>

    </div>
  </section>

  <!-- Strategic Location Advantage with Dubai Logistics Image -->
  <section class="py-16 bg-canvas border-b border-industrial-border">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="bg-white rounded-lg border border-industrial-border p-8 sm:p-12 overflow-hidden">
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 items-center">
          <div class="lg:col-span-7" data-motion-fade-left>
            <span class="text-xs font-semibold uppercase tracking-widest text-bronze-700 block mb-2">
              Strategic Logistics Base
            </span>
            <h2 class="text-2xl sm:text-3xl font-display font-bold text-ink">
              Operating from Dubai's Premier Trade Corridors
            </h2>
            <p class="mt-4 text-sm sm:text-base text-ink-secondary leading-relaxed">
              Situated at <strong>G6304, Ground Floor, Dubai Traders Market, Yiwu Market, Jebel Ali</strong>, LANCOX FZCO benefits from the world's most advanced logistics infrastructure. Our operational hub connects directly to major maritime ports, international air cargo corridors, and arterial highways, facilitating rapid multi-modal dispatch across the UAE, Saudi Arabia, Oman, and the entire GCC region.
            </p>

            <div class="mt-6 flex flex-wrap gap-3 text-xs font-medium text-ink">
              <span class="px-3 py-1.5 bg-canvas border border-industrial-border rounded shadow-soft-sm">✓ Streamlined Customs Transit</span>
              <span class="px-3 py-1.5 bg-canvas border border-industrial-border rounded shadow-soft-sm">✓ Jebel Ali Port Sea Freight</span>
              <span class="px-3 py-1.5 bg-canvas border border-industrial-border rounded shadow-soft-sm">✓ Dubai Traders Market Hub</span>
              <span class="px-3 py-1.5 bg-canvas border border-industrial-border rounded shadow-soft-sm">✓ Rapid GCC Overland Haulage</span>
            </div>

            <div class="mt-8 flex items-center gap-4">
              <a
                href="/contact/"
                class="inline-flex items-center px-5 py-2.5 bg-ink hover:bg-bronze-700 text-white text-xs font-semibold uppercase tracking-wider rounded transition-colors"
              >
                <span>View Office Location & Contact Details</span>
              </a>
            </div>
          </div>

          <div class="lg:col-span-5 rounded-lg overflow-hidden border border-industrial-border shadow-soft-sm" data-motion-fade-right>
            <img
              src="/images/jafza-port-logistics.jpg"
              alt="Dubai maritime logistics hub and container terminal - LANCOX FZCO regional base"
              width="600"
              height="400"
              class="w-full h-full object-cover aspect-[4/3]"
              loading="lazy"
            />
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Continuous Scrolling Marquee -->
  <Marquee />

  <!-- Action Section -->
  <section class="py-14 bg-canvas text-center" data-motion-fade>
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-2xl font-display font-bold text-ink">Ready to Partner with LANCOX FZCO?</h2>
      <p class="mt-2 text-sm text-ink-secondary">
        Experience dependable procurement backed by international standards and responsive commercial service.
      </p>
      <div class="mt-6 flex items-center justify-center gap-4">
        <a href="/products/" class="px-6 py-3 bg-white border border-industrial-border text-ink text-xs font-semibold uppercase tracking-wider rounded hover:border-bronze-400">
          Browse Product Divisions
        </a>
        <a href="/contact/#rfq" class="px-6 py-3 bg-bronze-600 hover:bg-bronze-700 text-white text-xs font-semibold uppercase tracking-wider rounded">
          Submit an RFQ
        </a>
      </div>
    </div>
  </section>

</BaseLayout>
