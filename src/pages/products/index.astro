---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Breadcrumbs from "@/components/Breadcrumbs.astro";
import Marquee from "@/components/Marquee.astro";
import { productCategories } from "@/data/products";

const seoTitle = "Industrial Products & Equipment Scope UAE | LANCOX FZCO Dubai";
const seoDescription =
  "Comprehensive industrial supply catalog: Electrical equipment, Mechanical piping & valves, Industrial fasteners, Process instrumentation, and PPE safety gear. Dubai, UAE.";

const breadcrumbs = [
  { label: "Products & Supply Scope", href: "/products/" }
];
---

<BaseLayout
  title={seoTitle}
  description={seoDescription}
  breadcrumbs={[{ name: "Products & Supply Scope", item: "https://lancoxuae.com/products/" }]}
>
  <div class="bg-canvas-subtle border-b border-industrial-border">
    <Breadcrumbs items={breadcrumbs} />
  </div>

  <!-- Hero Header -->
  <section class="py-16 sm:py-20 bg-canvas-subtle border-b border-industrial-border relative overflow-hidden">
    <div class="absolute inset-0 bg-industrial-grid opacity-50 pointer-events-none"></div>

    <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl" data-motion-hero>
        <span class="text-xs font-semibold uppercase tracking-widest text-bronze-700 block mb-2">
          B2B Technical Supply Portfolio
        </span>
        <!-- Single Canonical H1 -->
        <h1 class="text-3xl sm:text-5xl font-display font-extrabold text-ink tracking-tight">
          Industrial Product Divisions & Technical Scope
        </h1>
        <p class="mt-4 text-base sm:text-lg text-ink-secondary leading-relaxed">
          LANCOX FZCO procures certified industrial products across five specialized divisions. Designed for engineers, EPC contractors, and procurement managers seeking full material compliance, MTC 3.1 certification, and prompt delivery across the UAE & Middle East.
        </p>

        <!-- Quick Navigation Jump Tags -->
        <div class="mt-8 flex flex-wrap gap-2">
          {productCategories.map((cat) => (
            <a
              href={`#${cat.slug}`}
              class="px-3 py-1.5 bg-white border border-industrial-border text-xs font-semibold text-ink rounded hover:border-bronze-500 hover:text-bronze-800 transition-colors shadow-soft-sm"
            >
              ↓ {cat.shortName}
            </a>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- Detailed Category Sections -->
  <div class="py-16 sm:py-24 bg-canvas space-y-20">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      {productCategories.map((category, index) => (
        <section
          id={category.slug}
          class="scroll-mt-28 mb-20 last:mb-0 bg-white rounded-lg border border-industrial-border shadow-soft-sm overflow-hidden"
          aria-labelledby={`heading-${category.slug}`}
          data-motion-fade
        >
          <!-- Category Header Bar with Editorial Image -->
          <div class="border-b border-industrial-border bg-canvas-subtle/50">
            <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 items-center">
              
              <!-- Category Visual (Span 4) -->
              <div class="lg:col-span-4 h-56 lg:h-full min-h-[220px] overflow-hidden border-b lg:border-b-0 lg:border-r border-industrial-border relative group">
                <img
                  src={category.image}
                  alt={`${category.name} industrial supply scope - LANCOX FZCO`}
                  width="600"
                  height="380"
                  class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                  loading="lazy"
                />
                <div class="absolute top-3 left-3">
                  <span class="text-xs font-bold uppercase tracking-wider text-bronze-800 bg-white/95 backdrop-blur-sm border border-bronze-200 px-2.5 py-1 rounded shadow-soft-sm">
                    Division 0{index + 1}
                  </span>
                </div>
              </div>

              <!-- Category Details & Actions (Span 8) -->
              <div class="lg:col-span-8 p-6 sm:p-8 flex flex-col justify-between">
                <div>
                  <div class="flex flex-wrap items-center gap-1.5 mb-2.5">
                    {category.standards.map((std) => (
                      <span class="text-[10px] uppercase font-semibold text-ink-muted bg-white border border-industrial-border px-2 py-0.5 rounded">
                        {std}
                      </span>
                    ))}
                  </div>

                  <h2 id={`heading-${category.slug}`} class="text-2xl sm:text-3xl font-display font-extrabold text-ink">
                    {category.name}
                  </h2>
                  <p class="mt-2 text-sm text-ink-secondary leading-relaxed">
                    {category.description}
                  </p>
                </div>

                <!-- Action Links -->
                <div class="mt-6 pt-4 border-t border-industrial-border flex flex-wrap items-center gap-3">
                  <a
                    href={`/products/${category.slug}/`}
                    class="inline-flex items-center justify-center px-5 py-2.5 bg-ink text-white font-display font-semibold text-xs uppercase tracking-wider rounded hover:bg-bronze-700 transition-colors shadow-soft-sm"
                  >
                    <span>Dedicated Technical Specs</span>
                    <svg class="w-3.5 h-3.5 ml-1.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
                    </svg>
                  </a>
                  <a
                    href={`/contact/?division=${category.slug}#rfq`}
                    class="inline-flex items-center justify-center px-5 py-2.5 bg-white text-bronze-800 border border-bronze-300 font-display font-semibold text-xs uppercase tracking-wider rounded hover:bg-bronze-50 transition-colors"
                  >
                    Quote This Division &rarr;
                  </a>
                </div>
              </div>

            </div>
          </div>

          <!-- Product Families Breakdown -->
          <div class="p-6 sm:p-10">
            <h3 class="text-xs font-bold uppercase tracking-wider text-ink-muted mb-6">
              Product Families & Included Specifications
            </h3>

            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6" data-motion-stagger>
              {category.productFamilies.map((family) => (
                <div class="p-5 rounded-lg bg-canvas border border-industrial-border/80 hover:border-bronze-300 transition-colors flex flex-col justify-between" data-motion-item>
                  <div>
                    <h4 class="font-display font-bold text-base text-ink mb-1.5">
                      {family.name}
                    </h4>
                    <p class="text-xs text-ink-muted mb-3 leading-relaxed">
                      {family.description}
                    </p>
                    <ul class="space-y-1.5 text-xs text-ink-secondary border-t border-industrial-border pt-3">
                      {family.items.map((item) => (
                        <li class="flex items-start gap-2">
                          <span class="text-bronze-600 font-bold">•</span>
                          <span>{item}</span>
                        </li>
                      ))}
                    </ul>
                  </div>
                </div>
              ))}
            </div>

            <!-- Key Applications Strip -->
            <div class="mt-8 pt-6 border-t border-industrial-border flex flex-col sm:flex-row sm:items-center justify-between gap-4 text-xs">
              <div class="flex flex-wrap items-center gap-2">
                <span class="font-semibold text-ink uppercase tracking-wider">Primary Applications:</span>
                {category.applications.map((app) => (
                  <span class="bg-canvas-subtle text-ink-secondary px-2.5 py-1 rounded border border-industrial-border">
                    {app}
                  </span>
                ))}
              </div>
              <a
                href={`/products/${category.slug}/`}
                class="font-semibold text-bronze-700 hover:text-bronze-900 shrink-0"
              >
                View technical data sheet guide &rarr;
              </a>
            </div>
          </div>
        </section>
      ))}

    </div>
  </div>

  <!-- Sourcing Standards Marquee -->
  <Marquee />

  <!-- Multi-Item RFQ Strip -->
  <section class="py-16 bg-white border-t border-industrial-border" data-motion-fade>
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <span class="text-xs font-semibold uppercase tracking-widest text-bronze-700 block mb-2">
        Consolidated Sourcing
      </span>
      <h2 class="text-2xl sm:text-3xl font-display font-bold text-ink">
        Need Items Across Multiple Product Categories?
      </h2>
      <p class="mt-3 text-sm text-ink-secondary max-w-xl mx-auto leading-relaxed">
        Save administrative overhead by submitting your complete Bill of Quantities (BOQ). We consolidate electrical, mechanical, fasteners, and safety gear into unified shipping schedules.
      </p>
      <div class="mt-6 flex flex-wrap items-center justify-center gap-4">
        <a
          href="/contact/?division=multi#rfq"
          class="px-7 py-3 bg-ink hover:bg-bronze-700 text-white font-display font-semibold text-xs uppercase tracking-wider rounded transition-colors"
        >
          Submit Multi-Division RFQ
        </a>
        <a
          href="/trade-network/"
          class="px-7 py-3 bg-canvas-subtle border border-industrial-border text-ink font-display font-semibold text-xs uppercase tracking-wider rounded hover:border-bronze-400 transition-colors"
        >
          Review Global Trade Network
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
