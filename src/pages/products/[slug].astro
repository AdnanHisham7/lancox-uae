---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Breadcrumbs from "@/components/Breadcrumbs.astro";
import ContactForm from "@/components/ContactForm.astro";
import Marquee from "@/components/Marquee.astro";
import { productCategories, type ProductCategory } from "@/data/products";
import { siteConfig } from "@/config/site.config";

export function getStaticPaths() {
  return productCategories.map((category) => ({
    params: { slug: category.slug },
    props: { category },
  }));
}

interface Props {
  category: ProductCategory;
}

const { category } = Astro.props;

const canonicalUrl = `${siteConfig.siteUrl}/products/${category.slug}/`;

const breadcrumbs = [
  { label: "Products", href: "/products/" },
  { label: category.shortName, href: `/products/${category.slug}/` },
];

// Product Category JSON-LD Schema
const categoryStructuredData = {
  "@context": "https://schema.org",
  "@type": "Product",
  name: category.name,
  description: category.description,
  brand: {
    "@type": "Brand",
    name: siteConfig.name,
  },
  offers: {
    "@type": "AggregateOffer",
    priceCurrency: "AED",
    offerCount: category.productFamilies.reduce((acc, f) => acc + f.items.length, 0),
    availability: "https://schema.org/InStock",
    seller: {
      "@type": "Organization",
      name: siteConfig.legalName,
      url: siteConfig.siteUrl,
    },
  },
  category: category.name,
};

// Related categories (excluding current)
const otherCategories = productCategories.filter((c) => c.slug !== category.slug);
---

<BaseLayout
  title={category.seoTitle}
  description={category.seoDescription}
  canonical={canonicalUrl}
  breadcrumbs={[
    { name: "Products", item: `${siteConfig.siteUrl}/products/` },
    { name: category.shortName, item: canonicalUrl },
  ]}
  structuredData={categoryStructuredData}
>
  <div class="bg-canvas-subtle border-b border-industrial-border">
    <Breadcrumbs items={breadcrumbs} />
  </div>

  <!-- Category Hero Section with High-Resolution Visual -->
  <section class="py-14 sm:py-20 bg-canvas-subtle border-b border-industrial-border relative overflow-hidden">
    <div class="absolute inset-0 bg-industrial-grid opacity-50 pointer-events-none"></div>

    <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 items-center">
        
        <!-- Left Details (Span 7) -->
        <div class="lg:col-span-7" data-motion-fade-left>
          <div class="flex items-center gap-2 mb-3">
            <span class="text-xs font-bold uppercase tracking-widest text-bronze-700 bg-bronze-50 border border-bronze-200 px-2.5 py-1 rounded">
              Division Overview
            </span>
            <span class="text-xs text-ink-muted">
              Regional Supply Scope
            </span>
          </div>

          <!-- Single Canonical H1 -->
          <h1 class="text-3xl sm:text-5xl font-display font-extrabold text-ink tracking-tight">
            {category.name}
          </h1>

          <p class="mt-4 text-base sm:text-lg text-ink-secondary leading-relaxed">
            {category.description}
          </p>

          <!-- Compliance Badges -->
          <div class="mt-6 flex flex-wrap items-center gap-2">
            <span class="text-xs font-semibold text-ink uppercase tracking-wider mr-1">Standards:</span>
            {category.standards.map((std) => (
              <span class="text-xs font-medium text-ink-secondary bg-white border border-industrial-border px-2.5 py-1 rounded shadow-soft-sm">
                {std}
              </span>
            ))}
          </div>

          <div class="mt-8 flex flex-wrap gap-4">
            <a
              href="#rfq-section"
              class="px-6 py-3 bg-ink hover:bg-bronze-700 text-white font-display font-semibold text-xs uppercase tracking-wider rounded transition-colors shadow-soft-sm"
            >
              Request Quotation for {category.shortName}
            </a>
            <a
              href="#specifications"
              class="px-6 py-3 bg-white border border-industrial-border text-ink font-display font-semibold text-xs uppercase tracking-wider rounded hover:bg-canvas transition-colors shadow-soft-sm"
            >
              View Technical Breakdown
            </a>
          </div>
        </div>

        <!-- Right Product Category Image (Span 5) -->
        <div class="lg:col-span-5" data-motion-fade-right>
          <div class="rounded-lg overflow-hidden border border-industrial-border shadow-soft-lg bg-white relative group">
            <img
              src={category.image}
              alt={`${category.name} - LANCOX FZCO certified stock`}
              width="640"
              height="400"
              class="w-full h-auto object-cover group-hover:scale-102 transition-transform duration-500 aspect-[16/10]"
              loading="eager"
            />
            <div class="absolute bottom-0 inset-x-0 bg-gradient-to-t from-ink/90 via-ink/50 to-transparent p-3.5 text-white">
              <span class="text-[10px] uppercase font-bold tracking-wider text-bronze-400 block">
                LANCOX Verified Catalog
              </span>
              <span class="text-xs text-slate-200">
                MTC 3.1 Certified & Pre-Inspected Quality
              </span>
            </div>
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- Technical Highlights Strip -->
  <section class="bg-white border-b border-industrial-border py-8">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6" data-motion-stagger>
        {category.highlights.map((highlight) => (
          <div class="p-4 rounded bg-canvas border border-industrial-border/70 flex items-start gap-3" data-motion-item>
            <span class="w-5 h-5 rounded-full bg-bronze-100 text-bronze-800 flex items-center justify-center shrink-0 font-bold text-xs mt-0.5">
              ✓
            </span>
            <p class="text-xs text-ink-secondary font-medium leading-relaxed">
              {highlight}
            </p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Detailed Product Families Breakdown -->
  <section id="specifications" class="py-16 sm:py-24 bg-canvas">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="max-w-2xl mb-12" data-motion-fade>
        <span class="text-xs font-semibold uppercase tracking-widest text-bronze-700 block mb-2">
          Technical Inventory & Sourcing
        </span>
        <h2 class="text-2xl sm:text-4xl font-display font-extrabold text-ink">
          {category.shortName} Product Families & Item Specifications
        </h2>
        <p class="mt-3 text-sm text-ink-secondary">
          Below is a comprehensive representation of our technical supply scope within this division. All items are available in standard and custom specifications with full mill certification.
        </p>
      </div>

      <div class="space-y-8" data-motion-stagger>
        {category.productFamilies.map((family, idx) => (
          <div class="bg-white p-6 sm:p-8 rounded-lg border border-industrial-border shadow-soft-sm" data-motion-item>
            <div class="flex flex-col sm:flex-row sm:items-baseline justify-between gap-2 pb-4 mb-4 border-b border-industrial-border">
              <div>
                <span class="text-xs font-bold text-bronze-700 uppercase tracking-wider block mb-1">
                  Family 0{idx + 1}
                </span>
                <h3 class="text-xl font-display font-bold text-ink">
                  {family.name}
                </h3>
              </div>
              <p class="text-xs text-ink-muted max-w-md sm:text-right">
                {family.description}
              </p>
            </div>

            <!-- Items Grid -->
            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-3 pt-2">
              {family.items.map((item) => (
                <div class="p-3 rounded bg-canvas-subtle/70 border border-industrial-border/60 flex items-center gap-2.5">
                  <span class="w-1.5 h-1.5 rounded-full bg-bronze-500 shrink-0"></span>
                  <span class="text-xs font-medium text-ink">{item}</span>
                </div>
              ))}
            </div>
          </div>
        ))}
      </div>

      <!-- Applications Matrix -->
      <div class="mt-14 bg-white p-6 sm:p-8 rounded-lg border border-industrial-border" data-motion-fade>
        <h3 class="font-display font-bold text-lg text-ink mb-3">
          Key Industrial Applications & Operating Environments
        </h3>
        <p class="text-xs text-ink-secondary mb-4">
          This division's products are engineered to perform in demanding environments including:
        </p>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
          {category.applications.map((app) => (
            <div class="p-3.5 bg-canvas rounded border border-industrial-border text-xs text-ink-secondary flex items-start gap-2">
              <span class="text-bronze-600 font-bold">•</span>
              <span>{app}</span>
            </div>
          ))}
        </div>
      </div>

    </div>
  </section>

  <!-- Marquee of Trade Standards -->
  <Marquee title={`Engineering Standards Governing ${category.shortName}`} />

  <!-- Embedded RFQ Section Pre-Selecting Current Category -->
  <section id="rfq-section" class="py-16 sm:py-24 bg-canvas-subtle border-t border-industrial-border" data-motion-fade>
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-10">
        <span class="text-xs font-semibold uppercase tracking-widest text-bronze-700 block mb-2">
          Technical Quotation
        </span>
        <h2 class="text-2xl sm:text-3xl font-display font-bold text-ink">
          Request a Quote for {category.name}
        </h2>
        <p class="text-xs sm:text-sm text-ink-secondary mt-2 max-w-xl mx-auto">
          Specify your sizes, pressure classes, wall thicknesses, alloy grades, or quantities. Our commercial procurement team will respond with competitive terms.
        </p>
      </div>

      <ContactForm defaultCategory={category.name} formId={`rfq-${category.slug}`} />
    </div>
  </section>

  <!-- Cross-Category Navigation -->
  <section class="py-14 bg-white border-t border-industrial-border">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex items-center justify-between mb-8" data-motion-fade>
        <div>
          <span class="text-xs font-semibold uppercase tracking-wider text-bronze-700 block">Related Divisions</span>
          <h2 class="text-xl sm:text-2xl font-display font-bold text-ink">Explore Complementary Supply Scopes</h2>
        </div>
        <a href="/products/" class="text-xs font-semibold text-bronze-700 hover:underline">
          All Products &rarr;
        </a>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6" data-motion-stagger>
        {otherCategories.map((c) => (
          <a
            href={`/products/${c.slug}/`}
            class="p-5 rounded-lg bg-canvas border border-industrial-border hover:border-bronze-400 hover:shadow-soft-md transition-all group"
            data-motion-item
          >
            <span class="text-[10px] font-bold uppercase tracking-wider text-bronze-700 block mb-1">
              Division
            </span>
            <h3 class="font-display font-bold text-sm text-ink group-hover:text-bronze-700 transition-colors">
              {c.name}
            </h3>
            <p class="text-xs text-ink-muted mt-1.5 line-clamp-2">
              {c.tagline}
            </p>
            <span class="text-xs font-semibold text-bronze-700 mt-3 inline-block">
              View Specifications &rarr;
            </span>
          </a>
        ))}
      </div>
    </div>
  </section>

</BaseLayout>
