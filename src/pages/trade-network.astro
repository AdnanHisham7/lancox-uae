---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Breadcrumbs from "@/components/Breadcrumbs.astro";
import Marquee from "@/components/Marquee.astro";
import ClientsSection from "@/components/ClientsSection.astro";
import { tradeCorridors, tradeNetworkPillars, approvedBrands } from "@/data/tradeNetwork";
import { siteConfig } from "@/config/site.config";

const seoTitle = "Global Trade Network & Approved Brands | LANCOX FZCO Dubai";
const seoDescription =
  "Explore LANCOX FZCO's global procurement network. Supplying authorized manufacturing brands (Schneider Electric, Siemens, ABB, OMRON, Phoenix Contact, Honeywell, L&T) to esteemed clients including DEWA and Sharjah Municipality.";

const breadcrumbs = [
  { label: "Global Trade Network", href: "/trade-network/" }
];
---

<BaseLayout
  title={seoTitle}
  description={seoDescription}
  breadcrumbs={[{ name: "Global Trade Network", item: "https://lancoxuae.com/trade-network/" }]}
>
  <div class="bg-canvas-subtle border-b border-industrial-border">
    <Breadcrumbs items={breadcrumbs} />
  </div>

  <!-- Hero Header -->
  <section class="py-14 sm:py-20 bg-canvas-subtle border-b border-industrial-border relative overflow-hidden">
    <div class="absolute inset-0 bg-industrial-grid opacity-50 pointer-events-none"></div>

    <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl" data-motion-hero>
        <span class="text-xs font-semibold uppercase tracking-widest text-bronze-700 block mb-2">
          International Supply Chain
        </span>
        <!-- Single Canonical H1 -->
        <h1 class="text-3xl sm:text-5xl font-display font-extrabold text-ink tracking-tight">
          Global Supplier & Trade Network
        </h1>
        <p class="mt-4 text-base sm:text-lg text-ink-secondary leading-relaxed">
          Headquartered in Dubai, UAE, LANCOX FZCO serves as a strategic trading bridge connecting premier international manufacturing brands to key public sector clients — including <strong>Dubai Electricity and Water Authority (DEWA)</strong> and <strong>Sharjah Municipality</strong> — as well as regional contractors and industrial enterprises.
        </p>
        <div class="mt-6 flex flex-wrap gap-3">
          <a
            href="#brands"
            class="px-5 py-2.5 bg-ink text-white font-display font-semibold text-xs uppercase tracking-wider rounded hover:bg-bronze-700 transition-colors shadow-soft-sm"
          >
            Approved Brand Portfolio
          </a>
          <a
            href="#clients"
            class="px-5 py-2.5 bg-white border border-industrial-border text-ink font-display font-semibold text-xs uppercase tracking-wider rounded hover:border-bronze-500 hover:text-bronze-800 transition-colors shadow-soft-sm"
          >
            Our Clients (DEWA & Sharjah Municipality)
          </a>
          <a
            href="#corridors"
            class="px-5 py-2.5 bg-white border border-industrial-border text-ink font-display font-semibold text-xs uppercase tracking-wider rounded hover:bg-canvas transition-colors shadow-soft-sm"
          >
            Global Trade Corridors
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Global Trade Corridors Map Spotlight (From PDF Page 8) -->
  <section class="py-16 bg-white border-b border-industrial-border" data-motion-fade>
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center max-w-2xl mx-auto mb-10">
        <span class="text-xs font-semibold uppercase tracking-widest text-bronze-700 block mb-1">
          International Trade Routing
        </span>
        <h2 class="text-2xl sm:text-3xl font-display font-bold text-ink">
          Global Logistics Hub: Dubai, UAE
        </h2>
        <p class="text-xs sm:text-sm text-ink-muted mt-2">
          Direct supply corridors connecting North America, Europe, East Asia, and China straight into our Dubai logistics depot.
        </p>
      </div>

      <div class="rounded-lg overflow-hidden border border-industrial-border shadow-soft-md bg-canvas-subtle p-3 sm:p-6">
        <img
          src="/images/trade-network-map.jpg"
          alt="Global trade network map showing logistics shipping routes converging into Dubai UAE - LANCOX FZCO"
          width="1280"
          height="720"
          class="w-full h-auto object-cover rounded aspect-[16/9]"
          loading="eager"
        />
      </div>
    </div>
  </section>

  <!-- Approved Brand Network: Scattered Bubbles UI (From PDF Page 8) -->
  <section id="brands" class="py-16 sm:py-24 bg-canvas border-b border-industrial-border relative overflow-hidden">
    <!-- Ambient organic gradient background lights -->
    <div class="absolute -top-24 -left-24 w-96 h-96 bg-bronze-100/60 rounded-full blur-3xl pointer-events-none"></div>
    <div class="absolute -bottom-24 -right-24 w-96 h-96 bg-amber-100/50 rounded-full blur-3xl pointer-events-none"></div>

    <!-- Decorative floating bubble dots -->
    <div class="absolute top-1/4 left-8 w-3 h-3 rounded-full bg-bronze-300/40 pointer-events-none hidden md:block"></div>
    <div class="absolute bottom-1/3 right-10 w-4 h-4 rounded-full bg-amber-300/40 pointer-events-none hidden md:block"></div>
    <div class="absolute top-2/3 left-1/4 w-2 h-2 rounded-full bg-bronze-400/30 pointer-events-none hidden md:block"></div>
    <div class="absolute top-12 right-1/4 w-3.5 h-3.5 rounded-full bg-amber-400/30 pointer-events-none hidden md:block"></div>

    <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center max-w-2xl mx-auto mb-14" data-motion-fade>
        <span class="text-xs font-semibold uppercase tracking-widest text-bronze-700 block mb-2">
          Verified Brand Relationships
        </span>
        <h2 class="text-2xl sm:text-4xl font-display font-bold text-ink">
          Approved Brands & Manufacturers
        </h2>
        <p class="mt-3 text-sm text-ink-secondary leading-relaxed">
          LANCOX FZCO procures genuine materials directly from accredited international brand manufacturers across electrical, mechanical, automation, and safety disciplines.
        </p>
      </div>

      <!-- Organic Scattered Bubbles Field with Real Logos -->
      <div class="flex flex-wrap items-center justify-center gap-3.5 sm:gap-5 max-w-5xl mx-auto py-2" data-motion-stagger>
        {approvedBrands.map((brand, idx) => {
          const isFeatured = idx % 3 === 0;
          const offsetClass = idx % 4 === 1 ? "sm:translate-y-3" : idx % 4 === 3 ? "sm:-translate-y-3" : "";

          return (
            <div
              class={`group relative inline-flex items-center gap-3 px-4 py-2.5 sm:px-5 sm:py-3 rounded-full border bg-white shadow-soft-sm hover:shadow-soft-md transition-all duration-300 hover:scale-105 hover:-translate-y-1.5 cursor-default ${offsetClass} ${
                isFeatured
                  ? "border-bronze-300 ring-1 ring-bronze-200/60 hover:border-bronze-500"
                  : "border-industrial-border hover:border-bronze-400"
              }`}
              data-motion-item
            >
              <!-- Brand Logo Plate inside Bubble -->
              <div class="w-12 h-9 sm:w-14 sm:h-10 rounded-full bg-canvas-subtle border border-industrial-border/70 flex items-center justify-center p-1.5 shrink-0 overflow-hidden transition-transform duration-300 group-hover:scale-110">
                {brand.logo ? (
                  <img
                    src={brand.logo}
                    alt={`${brand.name} logo`}
                    width="56"
                    height="36"
                    class="max-w-full max-h-full object-contain"
                    loading="lazy"
                  />
                ) : (
                  <span class="font-display font-extrabold text-xs text-bronze-700">
                    {brand.name.substring(0, 2).toUpperCase()}
                  </span>
                )}
              </div>

              <!-- Brand Name & Category -->
              <div class="text-left">
                <div class="flex items-center gap-1.5">
                  <span class="font-display font-bold text-sm sm:text-base text-ink tracking-tight group-hover:text-bronze-700 transition-colors">
                    {brand.name}
                  </span>
                  <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 shrink-0" title="Verified Genuine Partner"></span>
                </div>
                <span class="text-[11px] text-ink-muted block leading-none mt-0.5 font-medium">
                  {brand.category}
                </span>
              </div>

              <!-- Verified Badge Tag -->
              <span class="text-[9px] uppercase tracking-wider font-semibold text-emerald-700 bg-emerald-50 px-2 py-0.5 rounded-full border border-emerald-200 hidden md:inline-block ml-1">
                Verified
              </span>
            </div>
          );
        })}
      </div>

      <!-- Trust Note Below Bubbles -->
      <div class="mt-12 text-center" data-motion-fade>
        <p class="text-xs text-ink-muted">
          Looking for a specific global brand not listed above? <a href="/contact/#rfq" class="text-bronze-700 font-semibold hover:underline">Submit your specification or BOQ</a> and our procurement team will source through verified global trade channels.
        </p>
      </div>
    </div>
  </section>

  <!-- Sourcing Pillars Grid -->
  <section class="py-16 sm:py-24 bg-white border-b border-industrial-border">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-2xl mb-12" data-motion-fade>
        <span class="text-xs font-semibold uppercase tracking-widest text-bronze-700 block mb-2">
          Procurement Integrity
        </span>
        <h2 class="text-2xl sm:text-3xl font-display font-bold text-ink">
          How We Ensure Quality Across Global Supply Lines
        </h2>
        <p class="mt-3 text-sm text-ink-secondary">
          Every component procured by LANCOX FZCO undergoes verified quality control protocols to protect operational safety and project timelines.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-8" data-motion-stagger>
        {tradeNetworkPillars.map((pillar, i) => (
          <div class="p-6 sm:p-8 rounded-lg bg-canvas border border-industrial-border shadow-soft-sm" data-motion-item>
            <div class="w-8 h-8 rounded bg-bronze-100 text-bronze-800 font-display font-bold text-xs flex items-center justify-center mb-4">
              0{i + 1}
            </div>
            <h3 class="text-lg font-display font-bold text-ink mb-2">
              {pillar.title}
            </h3>
            <p class="text-xs sm:text-sm text-ink-secondary leading-relaxed">
              {pillar.description}
            </p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Continuous Scrolling Marquee -->
  <Marquee title="Approved International Manufacturing Brands" />

  <!-- Key Clients & Government Authorities Section -->
  <ClientsSection bgClass="bg-canvas" id="clients" />

  <!-- Global Corridors & Sourcing Hubs Breakdown -->
  <section id="corridors" class="py-16 sm:py-24 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-2xl mb-12" data-motion-fade>
        <span class="text-xs font-semibold uppercase tracking-widest text-bronze-700 block mb-2">
          Logistical Reach
        </span>
        <h2 class="text-2xl sm:text-3xl font-display font-bold text-ink">
          Trade Corridors & Sourcing Origins
        </h2>
        <p class="mt-3 text-sm text-ink-secondary">
          Through strategic transport agreements and direct factory relationships, we orchestrate seamless freight movement into our regional consolidation facility.
        </p>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6" data-motion-stagger>
        {tradeCorridors.map((c) => (
          <div class="p-6 rounded-lg bg-canvas border border-industrial-border flex flex-col justify-between" data-motion-item>
            <div>
              <span class="text-xs font-bold uppercase tracking-wider text-bronze-700 block mb-1">
                {c.region}
              </span>
              <h3 class="text-lg font-display font-bold text-ink mb-2">
                {c.hub}
              </h3>
              <p class="text-xs text-ink-secondary leading-relaxed">
                {c.focus}
              </p>
            </div>
            <div class="mt-4 pt-3 border-t border-industrial-border text-[11px] text-ink-muted font-medium">
              Direct shipping to Jebel Ali Port & Airport
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

</BaseLayout>
