---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Breadcrumbs from "@/components/Breadcrumbs.astro";
import Marquee from "@/components/Marquee.astro";
import ClientsSection from "@/components/ClientsSection.astro";
import { industries } from "@/data/industries";

const seoTitle = "Industries Served | Electrical, Oil & Gas, Construction, Petrochemical | LANCOX FZCO";
const seoDescription =
  "LANCOX FZCO supplies certified industrial equipment to core sectors: Electrical & Power, Municipal Infrastructure, Oil & Gas, Construction, Energy, and Manufacturing in UAE. Trusted by DEWA and Sharjah Municipality.";

const breadcrumbs = [
  { label: "Industries Served", href: "/industries/" }
];
---

<BaseLayout
  title={seoTitle}
  description={seoDescription}
  breadcrumbs={[{ name: "Industries Served", item: "https://lancoxuae.com/industries/" }]}
>
  <div class="bg-canvas-subtle border-b border-industrial-border">
    <Breadcrumbs items={breadcrumbs} />
  </div>

  <!-- Hero Header -->
  <section class="py-16 sm:py-20 bg-canvas-subtle border-b border-industrial-border relative overflow-hidden">
    <div class="absolute inset-0 bg-industrial-grid opacity-50 pointer-events-none"></div>

    <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl" data-motion-hero>
        <span class="text-xs font-semibold uppercase tracking-widest text-bronze-700 block mb-2">
          Sector Experience & Application Knowledge
        </span>
        <!-- Single Canonical H1 -->
        <h1 class="text-3xl sm:text-5xl font-display font-extrabold text-ink tracking-tight">
          Industries Served Across the Middle East
        </h1>
        <p class="mt-4 text-base sm:text-lg text-ink-secondary leading-relaxed">
          From offshore oil platforms in the Arabian Gulf to large-scale urban infrastructure, power generation stations, and continuous processing plants, LANCOX FZCO delivers specialized procurement tailored to each industry's distinct operating and safety demands.
        </p>

        <!-- Quick Jump Navigation -->
        <div class="mt-8 flex flex-wrap gap-2">
          {industries.map((ind) => (
            <a
              href={`#${ind.id}`}
              class="px-3 py-1.5 bg-white border border-industrial-border text-xs font-semibold text-ink rounded hover:border-bronze-500 hover:text-bronze-800 transition-colors shadow-soft-sm"
            >
              ↓ {ind.name}
            </a>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- Industries Detailed Matrix -->
  <div class="py-16 sm:py-24 bg-canvas space-y-16">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-16">
      
      {industries.map((ind, index) => (
        <article
          id={ind.id}
          class="scroll-mt-28 bg-white rounded-lg border border-industrial-border shadow-soft-sm overflow-hidden"
          aria-labelledby={`industry-${ind.id}`}
          data-motion-fade
        >
          <!-- Industry Header Banner with Sector Photograph -->
          <div class="border-b border-industrial-border bg-canvas-subtle/40">
            <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 items-center">
              
              <!-- Sector Visual (Span 5) -->
              <div class="lg:col-span-5 h-64 lg:h-full min-h-[220px] overflow-hidden border-b lg:border-b-0 lg:border-r border-industrial-border relative group">
                <img
                  src={ind.image}
                  alt={`${ind.name} industrial operations and supply scope - LANCOX FZCO`}
                  width="640"
                  height="360"
                  class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                  loading="lazy"
                />
                <div class="absolute top-3 left-3">
                  <span class="text-xs font-bold uppercase tracking-wider text-bronze-800 bg-white/95 backdrop-blur-sm border border-bronze-200 px-2.5 py-1 rounded shadow-soft-sm">
                    Sector 0{index + 1}
                  </span>
                </div>
              </div>

              <!-- Sector Details & Quote CTA (Span 7) -->
              <div class="lg:col-span-7 p-6 sm:p-8 flex flex-col justify-between">
                <div>
                  <div class="flex items-center gap-2 mb-2">
                    <span class="text-xs text-ink-muted">
                      Standards: {ind.standards.join(" • ")}
                    </span>
                  </div>
                  <h2 id={`industry-${ind.id}`} class="text-2xl sm:text-3xl font-display font-extrabold text-ink">
                    {ind.name}
                  </h2>
                  <p class="mt-2 text-sm text-ink-secondary leading-relaxed">
                    {ind.tagline}
                  </p>
                </div>

                <div class="mt-6 pt-4 border-t border-industrial-border flex items-center justify-between">
                  <a
                    href={`/contact/?industry=${ind.id}#rfq`}
                    class="inline-flex items-center justify-center px-5 py-2.5 bg-ink hover:bg-bronze-700 text-white font-display font-semibold text-xs uppercase tracking-wider rounded transition-colors shadow-soft-sm"
                  >
                    <span>Quote {ind.name} Supplies</span>
                    <svg class="w-3.5 h-3.5 ml-1.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
                    </svg>
                  </a>
                </div>
              </div>

            </div>
          </div>

          <!-- Industry Details Grid -->
          <div class="p-6 sm:p-8 grid grid-cols-1 lg:grid-cols-12 gap-8">
            
            <!-- Left: Description & Solved Operational Challenges -->
            <div class="lg:col-span-6 space-y-6">
              <div>
                <h3 class="text-xs font-bold uppercase tracking-wider text-ink-muted mb-2">
                  Operating Environment & Scope
                </h3>
                <p class="text-sm text-ink-secondary leading-relaxed">
                  {ind.description}
                </p>
              </div>

              <div class="p-5 rounded-lg bg-canvas border border-industrial-border">
                <h4 class="font-display font-bold text-sm text-ink mb-2">
                  Critical Procurement Challenges Addressed:
                </h4>
                <ul class="space-y-2 text-xs text-ink-secondary">
                  {ind.challenges.map((ch) => (
                    <li class="flex items-start gap-2">
                      <span class="text-bronze-600 font-bold mt-0.5">✓</span>
                      <span>{ch}</span>
                    </li>
                  ))}
                </ul>
              </div>
            </div>

            <!-- Right: Tailored Supply Lines -->
            <div class="lg:col-span-6">
              <h3 class="text-xs font-bold uppercase tracking-wider text-ink-muted mb-3">
                Key Certified Materials Supplied:
              </h3>
              <div class="grid grid-cols-1 sm:grid-cols-2 gap-3" data-motion-stagger>
                {ind.keySupplies.map((supply) => (
                  <div class="p-3 rounded bg-canvas-subtle/80 border border-industrial-border/70 flex items-start gap-2.5" data-motion-item>
                    <span class="w-1.5 h-1.5 rounded-full bg-bronze-600 mt-1.5 shrink-0"></span>
                    <span class="text-xs font-medium text-ink leading-snug">{supply}</span>
                  </div>
                ))}
              </div>

              <!-- Quick Links to Matching Product Divisions -->
              <div class="mt-6 pt-4 border-t border-industrial-border flex flex-wrap items-center gap-4 text-xs">
                <span class="font-semibold text-ink">Related Categories:</span>
                <a href="/products/electrical/" class="text-bronze-700 hover:underline">Electrical</a>
                <span class="text-industrial-border">•</span>
                <a href="/products/mechanical/" class="text-bronze-700 hover:underline">Mechanical</a>
                <span class="text-industrial-border">•</span>
                <a href="/products/equipment-tools/" class="text-bronze-700 hover:underline">Equipment & Tools</a>
                <span class="text-industrial-border">•</span>
                <a href="/products/instrumentation/" class="text-bronze-700 hover:underline">Instrumentation</a>
                <span class="text-industrial-border">•</span>
                <a href="/products/safety/" class="text-bronze-700 hover:underline">Safety</a>
              </div>
            </div>

          </div>
        </article>
      ))}

    </div>
  </div>

  <!-- Key Clients & Public Sector Track Record -->
  <ClientsSection bgClass="bg-white" />

  <!-- Sourcing Standards Marquee -->
  <Marquee />

  <!-- Action CTA -->
  <section class="py-16 bg-white border-t border-industrial-border text-center" data-motion-fade>
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
      <span class="text-xs font-semibold uppercase tracking-widest text-bronze-700 block mb-2">
        Project Mobilization
      </span>
      <h2 class="text-2xl sm:text-3xl font-display font-bold text-ink">
        Mobilizing Supplies for an Upcoming Project or Turnaround?
      </h2>
      <p class="mt-3 text-sm text-ink-secondary leading-relaxed">
        Speak directly with our technical procurement officers to plan your material schedules, review approved manufacturer requirements, and secure competitive commercial pricing.
      </p>
      <div class="mt-6 flex flex-wrap items-center justify-center gap-4">
        <a
          href="/contact/#rfq"
          class="px-7 py-3 bg-bronze-600 hover:bg-bronze-700 text-white font-display font-semibold text-xs uppercase tracking-wider rounded transition-colors shadow-soft-sm"
        >
          Submit Line Item Specifications
        </a>
        <a
          href="/products/"
          class="px-7 py-3 bg-canvas-subtle border border-industrial-border text-ink font-display font-semibold text-xs uppercase tracking-wider rounded hover:border-bronze-400 transition-colors"
        >
          Explore All Products
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
