---
import { siteConfig } from "@/config/site.config";

interface Props {
  /** Transparent header laid over a full-bleed hero (home page). Turns solid on scroll. */
  overlay?: boolean;
}
const { overlay = false } = Astro.props;
const pathname = new URL(Astro.request.url).pathname;

// Helper to check active state
const isActive = (href: string) => {
  if (href === "/") return pathname === "/";
  return pathname.startsWith(href);
};
---

<div
  id="site-chrome"
  class:list={["site-chrome", overlay ? "is-overlay" : "is-sticky"]}
  data-state={overlay ? "top" : "solid"}
  data-menu="closed"
>
  <!-- Top Utility Credibility Strip (Desktop only) -->
  <div class="chrome-strip hidden lg:block text-xs">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 flex justify-between items-center h-10">
      <div class="flex items-center gap-6">
        <span class="inline-flex items-center gap-1.5 font-medium">
          <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
          </svg>
          Dubai, United Arab Emirates
        </span>
        <span class="chrome-sep" aria-hidden="true"></span>
        <span class="opacity-70">{siteConfig.tagline}</span>
      </div>
      <div class="flex items-center gap-6">
        <a
          href={`tel:${siteConfig.contact.phone}`}
          class="chrome-strip-link inline-flex items-center gap-1.5"
          data-track="phone-click"
        >
          <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
          </svg>
          <span>{siteConfig.contact.phoneDisplay}</span>
        </a>
        <span class="chrome-sep" aria-hidden="true"></span>
        <a
          href={`mailto:${siteConfig.contact.email}`}
          class="chrome-strip-link inline-flex items-center gap-1.5"
          data-track="email-click"
        >
          <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
          </svg>
          <span>{siteConfig.contact.email}</span>
        </a>
      </div>
    </div>
  </div>

  <!-- Main Header -->
  <header id="main-header" class="chrome-bar z-40">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex items-center justify-between h-[72px] lg:h-20">

        <!-- Brand Logo: brown on light, white on the hero (both are the same vector artwork) -->
        <a href="/" class="chrome-logo relative inline-flex items-center focus:outline-none focus-visible:ring-2 focus-visible:ring-bronze-500 rounded-sm" aria-label="LANCOX FZCO — Home">
          <img
            src="/images/lancox-logo.svg"
            alt="LANCOX FZCO"
            width="240"
            height="36"
            class="logo-dark h-7 sm:h-9 w-auto"
            loading="eager"
            decoding="async"
          />
          {overlay && (
            <img
              src="/images/lancox-logo-light.svg"
              alt=""
              aria-hidden="true"
              width="240"
              height="36"
              class="logo-light absolute inset-0 h-7 sm:h-9 w-auto"
              loading="eager"
              decoding="async"
            />
          )}
        </a>

        <!-- Desktop Navigation -->
        <nav class="hidden md:flex items-center gap-1 lg:gap-2" aria-label="Main Navigation">
          {siteConfig.navigation.map((item) => {
            const active = isActive(item.href);
            return (
              <a
                href={item.href}
                class="chrome-link relative px-3.5 py-2 text-sm font-medium"
                aria-current={active ? "page" : undefined}
              >
                {item.label}
              </a>
            );
          })}
        </nav>

        <!-- Header CTA & Actions -->
        <div class="hidden sm:flex items-center gap-3">
          <a
            href="/contact/"
            class="chrome-cta inline-flex items-center justify-center px-4 py-2.5 text-xs font-semibold uppercase tracking-wider text-white transition-all duration-200 rounded shadow-soft-sm hover:shadow-soft-md group"
            data-track="rfq-header-click"
          >
            <span>Request a Quote</span>
            <svg class="w-3.5 h-3.5 ml-2 group-hover:translate-x-0.5 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
            </svg>
          </a>
        </div>

        <!-- Mobile Menu Toggle Button -->
        <div class="flex md:hidden items-center gap-2">
          <a
            href="/contact/"
            class="chrome-cta px-2.5 py-1.5 text-xs font-semibold uppercase tracking-wider text-white rounded"
          >
            Quote
          </a>
          <button
            id="mobile-menu-btn"
            type="button"
            class="chrome-burger relative p-2.5 rounded-md focus:outline-none focus-visible:ring-2 focus-visible:ring-bronze-500 inline-flex items-center justify-center w-10 h-10"
            aria-expanded="false"
            aria-controls="mobile-menu"
            aria-label="Toggle navigation menu"
          >
            <svg id="menu-open-icon" class="w-6 h-6 menu-icon-open" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
            </svg>
            <svg id="menu-close-icon" class="w-6 h-6 menu-icon-close" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
            </svg>
          </button>
        </div>

      </div>
    </div>

    <!-- Mobile Dropdown Menu Drawer -->
    <div
      id="mobile-menu"
      class="mobile-menu-drawer md:hidden"
      aria-hidden="true"
    >
      <div class="mobile-menu-inner border-t border-industrial-border bg-white px-4 pt-3 pb-6 space-y-2 shadow-soft-lg">
        <nav class="space-y-1" aria-label="Mobile Navigation">
          {siteConfig.navigation.map((item) => {
            const active = isActive(item.href);
            return (
              <a
                href={item.href}
                class={`block px-3 py-2.5 text-base font-medium rounded-md transition-colors duration-150 ${
                  active
                    ? "bg-bronze-50 text-bronze-800 font-semibold"
                    : "text-ink-secondary hover:bg-canvas-subtle hover:text-ink"
                }`}
                aria-current={active ? "page" : undefined}
              >
                {item.label}
              </a>
            );
          })}
        </nav>
        <div class="pt-4 border-t border-industrial-border space-y-3">
          <a
            href="/contact/"
            class="w-full flex items-center justify-center px-4 py-3 text-sm font-semibold uppercase tracking-wider text-white bg-bronze-600 hover:bg-bronze-700 rounded shadow-soft-sm transition-colors"
          >
            Request a Quote (RFQ)
          </a>
          <div class="text-xs text-ink-muted space-y-1.5 pt-2">
            <p class="flex items-center gap-2">
              <svg class="w-4 h-4 text-bronze-600 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
              </svg>
              <a href={`tel:${siteConfig.contact.phone}`} class="text-ink font-medium hover:text-bronze-700">
                {siteConfig.contact.phoneDisplay}
              </a>
            </p>
            <p class="flex items-center gap-2">
              <svg class="w-4 h-4 text-bronze-600 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
              </svg>
              <a href={`mailto:${siteConfig.contact.email}`} class="text-ink hover:text-bronze-700">
                {siteConfig.contact.email}
              </a>
            </p>
          </div>
        </div>
      </div>
    </div>
  </header>
</div>

<style is:global>
  /* ------------------------------------------------------------------
     Site chrome (utility strip + header)
     - is-sticky : classic light header (inner pages)
     - is-overlay: transparent header floating over the hero, solid after scroll
  ------------------------------------------------------------------ */
  .site-chrome.is-sticky { display: contents; }
  .site-chrome.is-overlay { position: fixed; inset: 0 0 auto 0; z-index: 40; }

  /* utility strip */
  .chrome-strip { color: #3f4753; border-bottom: 1px solid #e5e2da; background: #f5f3ed; }
  .chrome-strip svg { color: #9b6c1a; }
  .chrome-strip-link:hover { color: #7a5116; }
  .chrome-sep { width: 1px; height: 12px; background: currentColor; opacity: .25; }

  .is-overlay .chrome-strip {
    background: transparent;
    color: rgba(255,255,255,.82);
    border-bottom-color: rgba(255,255,255,.14);
    max-height: 41px;
    overflow: hidden;
    transition: max-height .35s ease, opacity .25s ease, border-color .25s ease;
  }
  .is-overlay .chrome-strip svg { color: #e5cd94; }
  .is-overlay .chrome-strip-link:hover { color: #fff; }
  .is-overlay[data-state="scrolled"] .chrome-strip,
  .is-overlay[data-menu="open"] .chrome-strip { max-height: 0; opacity: 0; border-bottom-color: transparent; }

  /* bar */
  .is-sticky .chrome-bar {
    position: sticky; top: 0;
    background: rgba(255,255,255,.95);
    -webkit-backdrop-filter: blur(12px); backdrop-filter: blur(12px);
    border-bottom: 1px solid #e5e2da;
    transition: box-shadow .3s ease;
  }
  .is-sticky.is-lifted .chrome-bar { box-shadow: 0 4px 12px rgba(18,22,28,.06), 0 1px 3px rgba(18,22,28,.04); }

  .is-overlay .chrome-bar {
    position: relative;
    background: transparent;
    border-bottom: 1px solid transparent;
    transition: background-color .3s ease, border-color .3s ease, box-shadow .3s ease;
  }
  .is-overlay[data-state="scrolled"] .chrome-bar,
  .is-overlay[data-menu="open"] .chrome-bar {
    background: rgba(255,255,255,.96);
    -webkit-backdrop-filter: blur(14px); backdrop-filter: blur(14px);
    border-bottom-color: #e5e2da;
    box-shadow: 0 4px 12px rgba(18,22,28,.06), 0 1px 3px rgba(18,22,28,.04);
  }

  /* logo swap */
  .chrome-logo .logo-light { opacity: 0; transition: opacity .3s ease; }
  .chrome-logo .logo-dark  { transition: opacity .3s ease; }
  .is-overlay[data-state="top"][data-menu="closed"] .logo-light { opacity: 1; }
  .is-overlay[data-state="top"][data-menu="closed"] .logo-dark  { opacity: 0; }

  /* nav links: underline bar instead of pill highlight */
  .chrome-link { color: #3f4753; transition: color .2s ease; }
  .chrome-link::after {
    content: ""; position: absolute; left: .875rem; right: .875rem; bottom: .25rem; height: 2px;
    background: #b58424; transform: scaleX(0); transform-origin: left; transition: transform .25s ease;
  }
  .chrome-link:hover { color: #12161c; }
  .chrome-link:hover::after { transform: scaleX(.4); }
  .chrome-link[aria-current="page"] { color: #12161c; font-weight: 600; }
  .chrome-link[aria-current="page"]::after { transform: scaleX(1); }

  .is-overlay[data-state="top"][data-menu="closed"] .chrome-link { color: rgba(255,255,255,.86); }
  .is-overlay[data-state="top"][data-menu="closed"] .chrome-link:hover,
  .is-overlay[data-state="top"][data-menu="closed"] .chrome-link[aria-current="page"] { color: #fff; }
  .is-overlay[data-state="top"][data-menu="closed"] .chrome-link::after { background: #d4af61; }

  /* CTA + burger */
  .chrome-cta { background: #12161c; }
  .chrome-cta:hover { background: #7a5116; }
  .chrome-cta svg { color: #d4af61; }
  .chrome-cta:hover svg { color: #fff; }
  .is-overlay[data-state="top"][data-menu="closed"] .chrome-cta { background: #9b6c1a; }
  .is-overlay[data-state="top"][data-menu="closed"] .chrome-cta:hover { background: #b58424; }
  .is-overlay[data-state="top"][data-menu="closed"] .chrome-cta svg { color: #fff; }

  .chrome-burger { color: #3f4753; position: relative; width: 2.5rem; height: 2.5rem; }
  .chrome-burger:hover { color: #12161c; background: #f5f3ed; }
  .is-overlay[data-state="top"][data-menu="closed"] .chrome-burger { color: #fff; }
  .is-overlay[data-state="top"][data-menu="closed"] .chrome-burger:hover { background: rgba(255,255,255,.12); }

  /* Hamburger & Close icon smooth cross-fade rotation */
  .menu-icon-open,
  .menu-icon-close {
    position: absolute;
    transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1), opacity 0.22s ease;
  }
  .chrome-burger[aria-expanded="false"] .menu-icon-open {
    transform: rotate(0deg) scale(1);
    opacity: 1;
  }
  .chrome-burger[aria-expanded="false"] .menu-icon-close {
    transform: rotate(-90deg) scale(0.6);
    opacity: 0;
    pointer-events: none;
  }
  .chrome-burger[aria-expanded="true"] .menu-icon-open {
    transform: rotate(90deg) scale(0.6);
    opacity: 0;
    pointer-events: none;
  }
  .chrome-burger[aria-expanded="true"] .menu-icon-close {
    transform: rotate(0deg) scale(1);
    opacity: 1;
  }

  /* Mobile menu animated accordion drawer */
  .mobile-menu-drawer {
    display: grid;
    grid-template-rows: 0fr;
    transition: grid-template-rows 0.35s cubic-bezier(0.16, 1, 0.3, 1), visibility 0.35s ease;
    visibility: hidden;
  }
  .mobile-menu-drawer.is-open {
    grid-template-rows: 1fr;
    visibility: visible;
  }
  .mobile-menu-inner {
    overflow: hidden;
    min-height: 0;
    opacity: 0;
    transform: translateY(-8px);
    transition: opacity 0.28s ease, transform 0.35s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .mobile-menu-drawer.is-open .mobile-menu-inner {
    opacity: 1;
    transform: translateY(0);
  }

  @media (prefers-reduced-motion: reduce) {
    .site-chrome *, .site-chrome *::after { transition: none !important; }
    .mobile-menu-drawer, .mobile-menu-inner { transition: none !important; }
  }
</style>

<script is:inline>
  (function () {
    var chrome = document.getElementById('site-chrome');
    var menuBtn = document.getElementById('mobile-menu-btn');
    var mobileMenu = document.getElementById('mobile-menu');
    if (!chrome) return;

    var overlay = chrome.classList.contains('is-overlay');

    if (menuBtn && mobileMenu) {
      menuBtn.addEventListener('click', function () {
        var expanded = menuBtn.getAttribute('aria-expanded') === 'true';
        var nextState = !expanded;
        menuBtn.setAttribute('aria-expanded', String(nextState));
        mobileMenu.setAttribute('aria-hidden', String(!nextState));
        mobileMenu.classList.toggle('is-open', nextState);
        chrome.setAttribute('data-menu', nextState ? 'open' : 'closed');
      });

      var mobileLinks = mobileMenu.querySelectorAll('a');
      mobileLinks.forEach(function (link) {
        link.addEventListener('click', function () {
          menuBtn.setAttribute('aria-expanded', 'false');
          mobileMenu.setAttribute('aria-hidden', 'true');
          mobileMenu.classList.remove('is-open');
          chrome.setAttribute('data-menu', 'closed');
        });
      });
    }

    var ticking = false;
    function update() {
      ticking = false;
      var y = window.scrollY;
      if (overlay) {
        chrome.setAttribute('data-state', y > 24 ? 'scrolled' : 'top');
      } else {
        chrome.classList.toggle('is-lifted', y > 15);
      }
    }
    window.addEventListener('scroll', function () {
      if (!ticking) { ticking = true; requestAnimationFrame(update); }
    }, { passive: true });
    update();
  })();
</script>
