---
import { clients } from "@/data/clients";

export interface Props {
  id?: string;
  title?: string;
  subtitle?: string;
  eyebrow?: string;
  bgClass?: string;
}

const {
  id = "clients",
  title = "Trusted by Key Clients & Government Authorities",
  subtitle = "LANCOX FZCO is a trusted supply partner delivering certified industrial equipment, electrical power components, and municipal maintenance supplies to premier UAE government entities.",
  eyebrow = "Proven Client Track Record • UAE Government Authorities",
  bgClass = "bg-white",
} = Astro.props;
---

<section id={id} class={`py-14 sm:py-20 ${bgClass} border-b border-industrial-border relative overflow-hidden scroll-mt-20`} aria-labelledby="clients-heading">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Section Heading -->
    <div class="text-center max-w-3xl mx-auto mb-12 sm:mb-16" data-motion-fade>
      <span class="inline-flex items-center gap-2 px-3 py-1 rounded bg-bronze-50 border border-bronze-200 text-bronze-800 text-xs font-bold uppercase tracking-wider mb-3">
        {eyebrow}
      </span>
      <h2 id="clients-heading" class="text-2xl sm:text-4xl font-display font-extrabold text-ink tracking-tight">
        {title}
      </h2>
      <p class="mt-3 text-sm sm:text-base text-ink-secondary leading-relaxed">
        {subtitle}
      </p>
    </div>

    <!-- Client Authority Cards Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-8 max-w-5xl mx-auto" data-motion-stagger>
      {clients.map((client) => (
        <div
          class="group rounded-xl bg-canvas border border-industrial-border p-6 sm:p-8 shadow-soft-sm hover:border-bronze-400 hover:shadow-soft-md transition-all flex flex-col justify-between"
          data-motion-item
        >
          <div>
            <!-- Top Bar: Logo & Badge -->
            <div class="flex items-center justify-between gap-4 pb-6 border-b border-industrial-border">
              <!-- Logo Container -->
              <div class="h-16 sm:h-20 w-44 sm:w-52 bg-white rounded-lg border border-industrial-border/70 p-2 sm:p-3 flex items-center justify-center shrink-0 shadow-sm group-hover:border-bronze-300 transition-colors">
                <img
                  src={client.logo}
                  alt={`${client.fullName} logo`}
                  width="200"
                  height="70"
                  class="max-w-full max-h-full object-contain"
                  loading="lazy"
                />
              </div>

              <!-- Authority Status Badge -->
              <div class="text-right">
                <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-[11px] font-bold uppercase tracking-wider bg-emerald-50 text-emerald-800 border border-emerald-200">
                  <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 animate-pulse"></span>
                  Active Client
                </span>
                <span class="text-[11px] text-ink-muted block mt-1 font-medium">{client.location}</span>
              </div>
            </div>

            <!-- Content -->
            <div class="pt-6">
              <div class="flex items-baseline gap-2 mb-1">
                <h3 class="font-display font-extrabold text-xl text-ink">
                  {client.name}
                </h3>
                {client.arabicName && (
                  <span class="text-xs text-ink-muted font-normal" dir="rtl">
                    ({client.arabicName})
                  </span>
                )}
              </div>
              
              <h4 class="text-xs font-semibold text-bronze-700 uppercase tracking-wider mb-2">
                {client.fullName}
              </h4>

              <p class="text-xs sm:text-sm text-ink-secondary leading-relaxed mb-4">
                {client.scope}
              </p>

              <!-- Supply Highlights -->
              <div class="bg-white rounded-lg p-3.5 border border-industrial-border/60">
                <span class="text-[11px] font-bold uppercase tracking-wider text-ink block mb-2">
                  Key Supply Scope & Capabilities:
                </span>
                <ul class="space-y-1.5 text-xs text-ink-secondary">
                  {client.highlights.map((item) => (
                    <li class="flex items-start gap-2">
                      <span class="text-bronze-600 font-bold shrink-0 mt-0.5">✓</span>
                      <span>{item}</span>
                    </li>
                  ))}
                </ul>
              </div>
            </div>
          </div>

          <!-- Footer Trust Statement -->
          <div class="mt-6 pt-4 border-t border-industrial-border flex items-center justify-between text-xs text-ink-muted">
            <span class="font-medium text-ink">Client Category:</span>
            <span class="font-semibold text-bronze-800">{client.category}</span>
          </div>
        </div>
      ))}
    </div>

    <!-- Trust Endorsement Callout -->
    <div class="mt-12 text-center max-w-2xl mx-auto" data-motion-fade>
      <p class="text-xs text-ink-muted leading-relaxed">
        LANCOX FZCO complies with vendor registration and procurement specifications required by UAE utilities and municipal departments.
        <a href="/contact/#rfq" class="text-bronze-700 font-semibold underline hover:text-bronze-900 ml-1">
          Request documentation or vendor pre-qualification data &rarr;
        </a>
      </p>
    </div>

  </div>
</section>
